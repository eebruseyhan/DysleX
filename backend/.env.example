# PostgreSQL Bağlantı Bilgileri
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dyslex_db

# Veya doğrudan bağlantı URL'si:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dyslex_db

# JWT Ayarları (üretimde mutlaka güçlü ve rastgele bir değer kullanın)
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dosya Yükleme
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# CORS (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
